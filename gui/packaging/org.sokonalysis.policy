<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>sokonalysis</vendor>
  <vendor_url>https://github.com/sokonalysis/sokonalysis</vendor_url>
  <icon_name>sokonalysis</icon_name>

  <action id="org.sokonalysis.run">
    <description>Run sokonalysis</description>
    <message>Authentication is required to run sokonalysis</message>
    <icon_name>sokonalysis</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <!-- Must be the exact path pkexec is asked to run -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/sokonalysis/sokonalysis</annotate>
    <!-- Keep DISPLAY / XAUTHORITY so the GUI can open as root (no `env` wrapper needed) -->
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
